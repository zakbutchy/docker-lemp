[mysqld]
# クライアント接続時の逆引き（IP→ホスト名）DNS解決をスキップし、接続時の遅延を防ぐ
# （副作用として、mysql.userのHost列はIPアドレスかlocalhostのみで運用する前提になる）
skip-name-resolve

# データベースファイルの格納先
datadir = /var/lib/mysql
# Unixソケットの配置場所
socket = /var/run/mysqld/mysqld.sock
# LOAD DATA / SELECT INTO OUTFILEなどファイルI/Oを許可するディレクトリ
secure-file-priv = /var/lib/mysql-files
# mysqldを実行するOSユーザー
user = mysql
# クライアント/サーバー間でやり取りできる1パケットあたりの最大サイズ
max_allowed_packet = 16MB

# プロセスIDファイルの配置場所
pid-file = /var/run/mysqld/mysqld.pid

# character set / collation
# デフォルトの文字セット
character_set_server = utf8mb4
# 日本語向けの照合順序（アクセント・大文字小文字を区別）
collation_server = utf8mb4_ja_0900_as_cs_ks

# timezone
# OS（コンテナ）のタイムゾーンに従う
default-time-zone = SYSTEM
log_timestamps = SYSTEM

# Error Log
# 未指定ならベースイメージのデフォルト（標準エラー出力）が使われ、docker compose logsで追える。
# 明示的にstderrを指定すると起動オプション解析中の初期エラーが出力されなくなる場合があるため未指定のままにする

# Slow Query Log
# 実行に時間がかかったクエリを記録する（開発時のパフォーマンス調査用）
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/mysql-slow.log
# この秒数を超えたクエリを「スロークエリ」として記録する
long_query_time = 1.0
# インデックスを使用していないだけのクエリまではログしない
log_queries_not_using_indexes = 0

# General Log
# 全クエリを記録する（開発時の動作確認用。I/O負荷が高いため本番では無効化すること）
general_log = 1
general_log_file = /var/lib/mysql/mysql-general.log

[mysql]
default-character-set = utf8mb4

[client]
default-character-set = utf8mb4
